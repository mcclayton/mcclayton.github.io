{
  "name": "mcclayton.github.io",
  "version": "1.0.0",
  "author": "Michael Clayton",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.2",
    "classnames": "^2.5.1",
    "copy-text-to-clipboard": "^3.2.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.3"
  },
  "keywords": [
    "Michael Clayton",
    "Online Portfolio"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:pages": "npm run build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css}\"",
    "test": "vitest",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit --allowJs --checkJs --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck vite.config.mjs",
    "verify": "npm run typecheck && npm run build && npm run test -- --run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@10.8.2"
}
